<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.voltbridge</groupId><artifactId>voltbridge-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
    <artifactId>voltbridge-testing</artifactId>
    <dependencies>
        <dependency><groupId>com.voltbridge</groupId><artifactId>voltbridge-device-api</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.voltbridge</groupId><artifactId>voltbridge-protocol-common</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.voltbridge</groupId><artifactId>voltbridge-protocol-yunkuaichong</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>simulator</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>build-standalone-device-simulator</id>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <outputFile>${project.build.directory}/voltbridge-device-simulator.jar</outputFile>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>com.voltbridge.testing.simulator.scenario.ManualSimulatorMain</mainClass>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
