# Docker Compose 端口；如本机端口已占用可改为 15432、19092、16379 等。
POSTGRES_PORT=5432
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
REDIS_PORT=6379

# 应用数据库连接。示例密码仅供本地 Docker 开发，生产环境必须使用安全密钥管理。
DB_URL=jdbc:postgresql://localhost:5432/voltbridge
DB_USERNAME=postgres
DB_PASSWORD=voltbridge
POSTGRES_PASSWORD=voltbridge
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_TIMEOUT=2s

HTTP_PORT=8080
ROUTING_MODE=redis
GATEWAY_NODE_ID=gateway-a
GATEWAY_NODE_INSTANCE_ID=
GATEWAY_GRPC_ADVERTISED_HOST=localhost
GATEWAY_GRPC_PORT=9090
GATEWAY_GRPC_ADVERTISED_PORT=9090
TCP_PORT=9000
OCPP_WEBSOCKET_PORT=9100
GATEWAY_ROUTE_LEASE=PT90S
GATEWAY_ROUTE_REFRESH_INTERVAL=PT30S
GATEWAY_NODE_TTL=PT90S
GATEWAY_NODE_REFRESH_INTERVAL=PT30S
